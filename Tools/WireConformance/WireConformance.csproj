<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the engine-independent half of the networking layer outside Unity.

    The Unity Editor is the only thing that can compile the assembly as a whole,
    and it is not always available. Everything under Protocol/, Json/, Codec/ and
    Snapshot/ deliberately avoids UnityEngine and UniTask precisely so it can be
    exercised here instead: `dotnet run` from this directory type-checks it and
    asserts the wire format against bytes copied from the server sources.

    The sources are INCLUDED, not copied. A second copy would drift, which is the
    same failure the shared wire schema exists to prevent.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Unity 6 with IL2CPP and .NET Standard 2.1 compiles C# 9. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>WireConformance</AssemblyName>
    <RootNamespace>WireConformance</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Scripts/Net/Protocol/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Net/Json/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Net/Codec/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Net/Snapshot/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Net/Transport/WireFraming.cs" />
    <Compile Include="../../Assets/Scripts/Net/Transport/NetworkEndpoint.cs" />
    <Compile Include="../../Assets/Scripts/Net/Transport/TransportException.cs" />
    <Compile Include="../../Assets/Scripts/Net/Transport/TransportKind.cs" />
    <Compile Include="../../Assets/Scripts/Net/Transport/TransportKinds.cs" />
  </ItemGroup>

</Project>
