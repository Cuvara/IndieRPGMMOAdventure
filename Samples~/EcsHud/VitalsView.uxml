<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!--
        Structure only, per the UI architecture contract: element hierarchy plus the names
        the View queries for. No logic, no ECS query, no state — and no <Bindings> block:
        binding paths live in C# via nameof (see Documentation~/HYBRID-DATA-BINDING.md).
        This file is enrolled in the UXML codegen: saving it regenerates
        Generated/VitalsView.uxml.g.cs, and a renamed element fails compilation there
        instead of null-ing at runtime.
    -->
    <Style src="EcsHud.uss" />

    <ui:VisualElement name="ecs-hud" class="ecs-hud">
        <ui:Label name="health-caption" class="ecs-hud__caption" text="0/0" />
        <ui:VisualElement name="health-track" class="ecs-hud__track">
            <ui:VisualElement name="health-fill" class="ecs-hud__fill" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
