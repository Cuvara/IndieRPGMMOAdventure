/* motion presets used by this screen - generated from Penpot board 2ae07385-a5c7-8059-8008-e682adfe5381 ([approved] KitchenSinkSupported) - IR sha256:e7cbee0befaccf6c - do not edit */

.rpg-motion-press {
    transition-property: scale, -unity-background-image-tint-color;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}

.rpg-motion-press:active {
    scale: 0.96;
    -unity-background-image-tint-color: #cccccc;
}
