}

.rpg--crossfade-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.rpg--crossfade-hover {
    opacity: 0;
}

.rpg--crossfade:hover > .rpg--crossfade-hover:enabled {
    opacity: 1;
}

.rpg--crossfade-layer:disabled {
    opacity: 1;
}

.rpg--crossfade-hover:disabled {
    opacity: 0;
}

.rpg-button-hero--crossfade-normal {
    background-image: url("../Art/button.primary.normal.png");
    -unity-slice-left: 22;
    -unity-slice-top: 20;
    -unity-slice-right: 22;
    -unity-slice-bottom: 20;
