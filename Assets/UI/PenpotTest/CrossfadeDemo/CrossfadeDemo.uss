    -unity-slice-top: 20;
    -unity-slice-right: 22;
    -unity-slice-bottom: 20;
}

.rpg-button-hero.rpg--crossfade-button {
    background-image: none;
}

.rpg-button-hero.rpg--crossfade-button:hover {
    background-image: none;
}

.rpg-button-hero.rpg--crossfade-button:active {
    background-image: url("../Art/button.primary.pressed.png");
    -unity-slice-left: 22;
