.rpg-button-primary {
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/button.primary.normal.png");
    -unity-slice-left: 22;
    -unity-slice-top: 20;
    -unity-slice-right: 22;
    -unity-slice-bottom: 20;
}

.rpg-button-primary:hover {
    background-color: rgba(0, 0, 0, 0);
}

.rpg-button-primary:active {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../Art/button.primary.pressed.png");
    -unity-slice-left: 22;
    -unity-slice-top: 20;
    -unity-slice-right: 22;
    -unity-slice-bottom: 20;
}

.rpg-button-primary:disabled {
    opacity: 1;
    color: #888888;
}

.rpg-main-menu {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background-color: var(--rpg-color-bg);
}

.rpg-main-menu-title {
    width: 480px;
    height: 72px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: var(--rpg-color-text);
    font-size: 48px;
    -unity-font-definition: url("project://database/Assets/UI/PenpotTest/Fonts/SourceSansPro-Bold SDF.asset");
    letter-spacing: 1px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.rpg-main-menu-menu-panel {
    width: 520px;
    margin-top: 40px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding-top: 84px;
    padding-right: 84px;
    padding-bottom: 84px;
    padding-left: 84px;
    background-image: url("../Art/panel.frame.png");
    -unity-slice-left: 28;
