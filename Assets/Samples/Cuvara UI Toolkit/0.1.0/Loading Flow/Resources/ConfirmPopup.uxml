<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Popup.uss" />
    <ui:VisualElement class="popup-overlay">
        <ui:VisualElement class="popup-card">
            <ui:Label name="popup-title" text="Confirm" class="popup-title" />
            <ui:Label name="popup-body" text="" class="popup-body" />
            <ui:VisualElement class="popup-button-row">
                <ui:Button name="btn-cancel" text="Cancel" class="popup-button popup-button-gray" />
                <ui:Button name="btn-ok" text="OK" class="popup-button popup-button-orange" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
