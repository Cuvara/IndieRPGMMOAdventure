.popup-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
}

.popup-card {
    width: 420px;
    background-color: rgb(40, 44, 60);
    border-radius: 16px;
    padding: 30px;
    align-items: center;
}

.popup-card-wide {
    width: 500px;
}

.popup-title {
    font-size: 32px;
    color: rgb(230, 230, 250);
    margin-bottom: 20px;
    -unity-font-style: bold;
}

.popup-body {
    font-size: 18px;
    color: rgb(180, 180, 200);
    margin-bottom: 30px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.popup-button {
    width: 160px;
    height: 48px;
    font-size: 20px;
    border-radius: 10px;
    border-width: 0;
    color: white;
    -unity-font-style: bold;
    margin: 5px;
}

.popup-button:hover {
    scale: 1.05 1.05;
    transition-duration: 0.1s;
}

.popup-button:active {
    scale: 0.96 0.96;
}

.popup-button-row {
    flex-direction: row;
    justify-content: center;
}

.popup-button-blue { background-color: rgb(60, 130, 220); }
.popup-button-orange { background-color: rgb(220, 120, 40); }
.popup-button-green { background-color: rgb(80, 170, 80); }
.popup-button-gray { background-color: rgb(90, 90, 110); }

.setting-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 16px;
}

.setting-label {
    font-size: 20px;
    color: rgb(200, 200, 220);
    width: 140px;
}

.setting-slider {
    flex-grow: 1;
}
