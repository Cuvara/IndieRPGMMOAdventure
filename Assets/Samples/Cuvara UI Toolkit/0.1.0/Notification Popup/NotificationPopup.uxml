<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="NotificationPopup.uss" />

    <!--
        Seven named parts: two texts, three buttons, and the two rows the view toggles with
        display. The names are what NotificationPopupView queries for in its constructor —
        change one here and you must change it there.
        close-group  = NotificationType.Close  -> one OK button.
        notice-group = NotificationType.Option -> Cancel + OK.
    -->
    <ui:VisualElement name="notification-popup" class="notification-popup">
        <ui:VisualElement name="dimmer" class="notification-popup__dimmer" />

        <ui:VisualElement name="panel" class="notification-popup__panel">
            <ui:Label name="txt-title" class="notification-popup__title" text="Title" />
            <ui:Label name="txt-content" class="notification-popup__content" text="Content" />

            <ui:VisualElement name="close-group" class="notification-popup__buttons">
                <ui:Button name="btn-ok" class="notification-popup__button" text="OK" />
            </ui:VisualElement>

            <ui:VisualElement name="notice-group" class="notification-popup__buttons">
                <ui:Button name="btn-cancel" class="notification-popup__button notification-popup__button--secondary" text="Cancel" />
                <ui:Button name="btn-ok-notice" class="notification-popup__button" text="OK" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
