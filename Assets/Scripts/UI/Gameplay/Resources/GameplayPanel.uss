/* Presentation only. No logic of any kind. */
.gameplay-panel {
    position: absolute;
    right: 16px;
    top: 16px;
    width: 300px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 6px;
}

.gameplay-panel__stat {
    color: rgb(235, 235, 235);
    font-size: 14px;
}

.gameplay-panel__row {
    color: rgb(210, 210, 210);
    font-size: 12px;
    margin-top: 4px;
    white-space: normal;
}

.gameplay-panel__inventory {
    margin-top: 8px;
}

.gameplay-panel__caption {
    color: rgb(235, 235, 235);
    font-size: 13px;
    -unity-font-style: bold;
}

.gameplay-panel__list {
    height: 168px;
    margin-top: 4px;
}

.gameplay-panel__item {
    flex-direction: row;
    align-items: center;
    height: 28px;
}

.gameplay-panel__item-label {
    flex-grow: 1;
    color: rgb(220, 220, 220);
    font-size: 12px;
}

.gameplay-panel__item-button {
    font-size: 11px;
    margin-left: 2px;
    padding-left: 4px;
    padding-right: 4px;
}

.gameplay-panel__actions {
    flex-direction: row;
    margin-top: 4px;
}

.gameplay-panel__button {
    font-size: 12px;
}

.gameplay-panel__hint {
    color: rgb(160, 160, 160);
    font-size: 10px;
    margin-top: 6px;
    white-space: normal;
}
