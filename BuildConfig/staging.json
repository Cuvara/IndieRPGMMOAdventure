{
  "$schema": "../unity-build-workflows/schemas/unity-build-config.schema.json",
  "projectName": "IndieRPGMMOAdventure",
  "companyName": "Cuvara",
  "bundleVersion": "0.5.0",
  "productName": "IndieRPGMMOAdventure [STAGING]",
  "buildNumberStrategy": "github_run_number",

  "outputDirectory": "Builds/Staging",

  "scenes": [
    "Assets/Scenes/MainScene.unity"
  ],

  "scriptingBackend": "IL2CPP",
  "apiCompatibilityLevel": "NET_Standard_2_1",

  "developmentBuild": false,
  "allowDebugging": false,
  "connectProfiler": false,
  "deepProfiling": false,
  "cleanBuildCache": false,

  "runTests": true,

  "addressables": {
    "enabled": true,
    "profile": "Default",
    "buildRemoteCatalog": true
  },

  "android": {
    "applicationId": "com.cuvara.indierpgmmo.staging",
    "buildAppBundle": true,
    "minSdkVersion": 22,
    "targetSdkVersion": 34,
    "architecture": "ARM64",
    "keystoreMode": "custom",
    "symbolExport": "none"
  },

  "webgl": {
    "compressionFormat": "Brotli",
    "decompressionFallback": true,
    "dataCaching": true,
    "memorySize": 256,
    "template": "Default",
    "outputName": "WebGL"
  },

  "windows": {
    "architecture": "x86_64",
    "outputName": "IndieRPGMMOAdventure_Staging",
    "compressOutput": true
  },

  "gates": {
    "maxBuildSizeMB": 500,
    "warnBuildSizeIncreasePct": 10,
    "failBuildSizeIncreasePct": 25,
    "failOnWarnings": false,
    "requiredValidationRules": [
      "no_missing_references",
      "no_missing_scripts"
    ]
  },

  "metadata": {
    "repository": "https://github.com/Cuvara/IndieRPGMMOAdventure",
    "team": "mobile",
    "environment": "staging"
  },

  "hooks": {
    "preBuild": [],
    "postBuild": []
  }
}
