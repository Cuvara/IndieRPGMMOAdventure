<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- The codegen documentation's ConfirmPopup, enrolled for real: its bindings class
         is committed under Generated/ and asserted by GeneratedConfirmPopupTests, and the
         CI drift check regenerates this file and byte-compares. Editing a name here
         without regenerating is exactly what that check exists to catch. -->
    <ui:VisualElement name="popup-root">
        <ui:Label name="popup-title" text="Delete save?" />
        <ui:Label name="popup-body" text="This cannot be undone." />
        <ui:VisualElement name="button-row">
            <ui:Button name="btn-ok" text="OK" />
            <ui:Button name="btn-cancel" text="Cancel" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
