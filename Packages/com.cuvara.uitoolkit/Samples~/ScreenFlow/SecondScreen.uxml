<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="ScreenFlow.uss" />
    <ui:VisualElement name="second-screen" class="cuvara-sample-screen cuvara-sample-screen--second">
        <ui:Label name="title" class="cuvara-sample-title" text="Second screen" />
        <ui:Label name="hint" class="cuvara-sample-hint" text="The root is Suspended behind this — watch the HUD." />
        <ui:Button name="btn-push" class="cuvara-sample-button" text="Push another" />
        <ui:Button name="btn-modal" class="cuvara-sample-button" text="Show modal" />
        <ui:Button name="btn-pop" class="cuvara-sample-button" text="Pop (back)" />
        <ui:Button name="btn-pop-to-root" class="cuvara-sample-button" text="Pop to root" />
    </ui:VisualElement>
</ui:UXML>
