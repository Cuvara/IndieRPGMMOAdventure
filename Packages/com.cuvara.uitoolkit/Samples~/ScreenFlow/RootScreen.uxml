<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="ScreenFlow.uss" />
    <ui:VisualElement name="root-screen" class="cuvara-sample-screen cuvara-sample-screen--root">
        <ui:Label name="title" class="cuvara-sample-title" text="Root screen" />
        <ui:Label name="hint" class="cuvara-sample-hint" text="Depth 1. Back here does whatever RootBackPolicy says." />
        <ui:Button name="btn-push" class="cuvara-sample-button" text="Push second screen" />
        <ui:Button name="btn-modal" class="cuvara-sample-button" text="Show modal (dims this)" />
        <ui:Button name="btn-replace" class="cuvara-sample-button" text="Replace with second screen" />
    </ui:VisualElement>
</ui:UXML>
