<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!--
        The default root document for the UI Toolkit screen flow: the three layers
        RootUIDocument resolves by name, and the exact counterpart of the three child
        Transforms a uGUI root-canvas prefab carries.

        Assign this asset to the UIDocument beside a RootUIDocument and the names line up
        with that component's defaults; nothing else has to be configured.

        Order is paint order: closed is first and empty, show sits above it, overlay above
        both. Every layer is absolutely positioned and stretched, because a screen parented
        into one expects to fill it.

        picking-mode="Ignore" on the layers themselves, never on the screens inside them:
        an empty layer must not eat clicks meant for whatever is under it, and a layer with
        a screen in it still delivers events to that screen.
    -->
    <ui:VisualElement name="root-ui-layers" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="root-ui-closed" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; display: none;" />
        <ui:VisualElement name="root-ui-show" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
        <ui:VisualElement name="root-ui-overlay" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
    </ui:VisualElement>
</ui:UXML>
